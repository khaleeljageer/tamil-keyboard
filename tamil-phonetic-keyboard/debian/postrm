#!/bin/bash

set -e

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Clean up: restart ibus if needed
if pgrep ibus-daemon >/dev/null 2>&1; then
    killall ibus-daemon 2>/dev/null || true
    sleep 1
    if command_exists ibus-daemon; then
        ibus-daemon -drx &
    fi
fi

# Clean up reboot-required flag if this is the only package requiring reboot
if [ -f /var/run/reboot-required.pkgs ]; then
    # Remove this package from the list
    sed -i '/^tamil-phonetic-keyboard$/d' /var/run/reboot-required.pkgs 2>/dev/null || true
    # If no packages left, remove the reboot-required flag
    if [ ! -s /var/run/reboot-required.pkgs ]; then
        rm -f /var/run/reboot-required.pkgs /var/run/reboot-required 2>/dev/null || true
    fi
fi

# DEBIAN/postrm
exit 0

